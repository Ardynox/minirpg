[gd_scene format=3]

[node name="KeyBindingsView" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="ContextBar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ActionTab" type="Button" parent="ContextBar"]
layout_mode = 2
toggle_mode = true
size_flags_horizontal = 3
theme_type_variation = "TabButton"
text = "ui.key_bindings.context.action"

[node name="TypingTab" type="Button" parent="ContextBar"]
layout_mode = 2
toggle_mode = true
size_flags_horizontal = 3
theme_type_variation = "TabButton"
text = "ui.key_bindings.context.typing"

[node name="SelectionTab" type="Button" parent="ContextBar"]
layout_mode = 2
toggle_mode = true
size_flags_horizontal = 3
theme_type_variation = "TabButton"
text = "ui.key_bindings.context.selection"

[node name="DirectionTab" type="Button" parent="ContextBar"]
layout_mode = 2
toggle_mode = true
size_flags_horizontal = 3
theme_type_variation = "TabButton"
text = "ui.key_bindings.context.direction"

[node name="BindingsText" type="RichTextLabel" parent="."]
custom_minimum_size = Vector2(0, 320)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true

[node name="StatusLabel" type="Label" parent="."]
layout_mode = 2
text = ""

[node name="HintLabel" type="Label" parent="."]
layout_mode = 2
text = ""
theme_type_variation = &"HintLabel"

[node name="ActionBar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="BindPrimaryBtn" type="Button" parent="ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = "ActionButton"
text = "ui.key_bindings.button.bind_primary"

[node name="BindSecondaryBtn" type="Button" parent="ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = "ActionButton"
text = "ui.key_bindings.button.bind_secondary"

[node name="ResetContextBtn" type="Button" parent="ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = "ActionButton"
text = "ui.key_bindings.button.reset_context"

[node name="ResetAllBtn" type="Button" parent="ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = "ActionButton"
text = "ui.key_bindings.button.reset_all"
