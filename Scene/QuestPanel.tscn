[node name="TabBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Sep1" type="HSeparator" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="Content" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="LeftColumn" type="ScrollContainer" parent="MarginContainer/VBox/Content"]
