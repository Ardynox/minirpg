[gd_scene format=3]

[node name="QuestPanel" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.0
custom_minimum_size = Vector2(460, 0)
visible = false

[node name="MarginContainer" type="MarginContainer" parent="."]
