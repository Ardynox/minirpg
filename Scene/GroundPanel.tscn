[gd_scene format=3]

[node name="GroundPanel" type="PanelContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 4

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="MarginContainer/VBox"]
layout_mode = 2
theme_type_variation = "HeaderLabel"
text = "ui.ground.title"

[node name="ItemScroll" type="ScrollContainer" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ItemList" type="VBoxContainer" parent="MarginContainer/VBox/ItemScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="ActionBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PickupBtn" type="Button" parent="MarginContainer/VBox/ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = "ActionButton"
text = "ui.ground.pickup"

[node name="PickupAllBtn" type="Button" parent="MarginContainer/VBox/ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = "ActionButton"
text = "ui.ground.pickup_all"
