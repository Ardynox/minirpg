[gd_scene format=3]

[node name="GroundPanel" type="PanelContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 4

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 2

[node name="Header" type="RichTextLabel" parent="MarginContainer/VBox"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "── 脚下 ──"

[node name="ItemScroll" type="ScrollContainer" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
custom_minimum_size = Vector2(0, 24)

[node name="ItemList" type="VBoxContainer" parent="MarginContainer/VBox/ItemScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="ActionBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PickupBtn" type="Button" parent="MarginContainer/VBox/ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "拾取 [F]"

[node name="PickupAllBtn" type="Button" parent="MarginContainer/VBox/ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "全部拾取"
