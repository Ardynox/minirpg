[gd_scene format=3]

[node name="DebugPanel" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(620, 680)
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="MarginContainer" type="MarginContainer" parent="."]
