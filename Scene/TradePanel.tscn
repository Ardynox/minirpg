[gd_scene format=3]

[node name="TradePanel" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.0
custom_minimum_size = Vector2(340, 0)
visible = false

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 4

[node name="Header" type="RichTextLabel" parent="MarginContainer/VBox"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "── 交易 ──"

[node name="TabBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Sep1" type="HSeparator" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="ItemScroll" type="ScrollContainer" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ItemList" type="VBoxContainer" parent="MarginContainer/VBox/ItemScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Sep2" type="HSeparator" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="DetailBox" type="RichTextLabel" parent="MarginContainer/VBox"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_minimum_size = Vector2(0, 60)

[node name="ActionBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="BuyBtn" type="Button" parent="MarginContainer/VBox/ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "购买 [E]"

[node name="SellBtn" type="Button" parent="MarginContainer/VBox/ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "出售 [Q]"

[node name="CloseBtn" type="Button" parent="MarginContainer/VBox/ActionBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "关闭 [Esc]"

[node name="HintBar" type="RichTextLabel" parent="MarginContainer/VBox"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
