[gd_scene format=3]

[node name="SettingsPanel" type="PanelContainer"]
visible = false
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -200.0
offset_right = 200.0
offset_bottom = 200.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
text = "⚙️ 设置"
horizontal_alignment = 1

[node name="RenderToggle" type="Button" parent="VBox"]
layout_mode = 2
text = "切换渲染模式 (Emoji / ASCII)"

[node name="KeyBindingsLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "── 按键绑定 ──
W/A/S/D — 移动
L — 查看周围
F — 交互（对话/交易/驯服）
I — 打开背包
R — 切换渲染模式
空格 — 上下楼梯
T / Enter — 打字输入
F5 — 快速存档
F9 — 快速读档
ESC — 打开/关闭设置
数字键 0-9 — 菜单选择"

[node name="SaveBtn" type="Button" parent="VBox"]
layout_mode = 2
text = "保存游戏 💾"

[node name="LoadBtn" type="Button" parent="VBox"]
layout_mode = 2
text = "读取存档 📂"

[node name="BackToMenuBtn" type="Button" parent="VBox"]
layout_mode = 2
text = "返回主菜单"

[node name="CloseBtn" type="Button" parent="VBox"]
layout_mode = 2
text = "关闭 (ESC)"
