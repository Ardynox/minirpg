{
  "version": 1,
  "smoothing": {
    "paramLerpFactor": 0.3,
    "crossfadeDurationSec": 2.0,
    "idleRegenerateIntervalSec": 15.0,
    "recomposeThresholds": {
      "arousalDelta": 0.25,
      "valenceDelta": 0.2,
      "combatPulseEnter": 0.4,
      "mentalBreakPulseEnter": 0.4,
      "turnInterval": 3
    }
  },
  "scaleMapping": {
    "comment": "valence ranges map to scale types",
    "mentalBreak": "WholeTone",
    "highStress": "HarmonicMinor",
    "ranges": [
      { "minValence": 0.75, "highArousal": "Mixolydian", "default": "Ionian" },
      { "minValence": 0.55, "highArousal": "Mixolydian", "default": "Lydian" },
      { "minValence": 0.35, "default": "Dorian" },
      { "minValence": 0.20, "default": "Aeolian" },
      { "minValence": 0.00, "default": "Phrygian" }
    ]
  },
  "bpm": {
    "minBpm": 50,
    "maxBpm": 160,
    "arousalWeight": 80,
    "patienceWeight": -20,
    "combatBonus": 20,
    "mentalBreakBonus": 15,
    "nightPenalty": -10
  },
  "instrumentProfiles": {
    "lute": {
      "role": "melody",
      "midiRange": [48, 79],
      "sampleInterval": 6,
      "contexts": ["outdoor", "day", "default"]
    },
    "harp": {
      "role": "melody_arpeggio",
      "midiRange": [48, 84],
      "sampleInterval": 6,
      "contexts": ["indoor", "night", "peaceful"]
    },
    "recorder": {
      "role": "melody",
      "midiRange": [60, 84],
      "sampleInterval": 6,
      "contexts": ["combat", "alert"]
    },
    "viol": {
      "role": "bass",
      "midiRange": [36, 60],
      "sampleInterval": 6,
      "contexts": ["default"]
    },
    "percussion": {
      "role": "rhythm",
      "midiRange": [36, 48],
      "sampleInterval": 1,
      "contexts": ["combat", "tense"]
    }
  },
  "voiceWeights": {
    "pad": {
      "baseVolume": 0.35,
      "nightBonus": 0.1,
      "lowArousalBonus": 0.1,
      "rainBonus": 0.05
    },
    "melody": {
      "baseVolume": 0.7,
      "arousalBonus": 0.15,
      "nightPenalty": -0.1
    },
    "bass": {
      "baseVolume": 0.5,
      "arousalBonus": 0.15,
      "nightPenalty": -0.05
    },
    "rhythm": {
      "minArousal": 0.25,
      "baseVolume": 0.3,
      "arousalScale": 0.4,
      "aggressionBonus": 0.1
    },
    "arpeggio": {
      "indoorBonus": 0.2,
      "lowArousalBonus": 0.15,
      "valenceBonus": 0.1,
      "nightBonus": 0.1,
      "combatPenaltyScale": -0.3
    }
  },
  "personalityModulations": {
    "aggression": {
      "target": "percussion",
      "volumeScale": [0.8, 1.2]
    },
    "caution": {
      "effect": "dampen_loud_notes",
      "threshold": 0.6,
      "velocityMultiplier": 0.85
    },
    "sociability": {
      "target": ["harp", "lute"],
      "socialPulseVolumeBonus": 1.15
    },
    "curiosity": {
      "effect": "wider_intervals",
      "maxStepIncrease": 2,
      "surpriseJumpChance": 0.15
    },
    "patience": {
      "effect": "slower_tempo",
      "bpmOffset": -10
    }
  },
  "chordProgressions": {
    "peaceful":  [[0,6,5,6],[0,3,4,0],[0,2,5,0],[0,4,5,3]],
    "hopeful":   [[0,4,5,3],[0,3,6,4],[0,5,3,4],[0,2,4,0]],
    "melancholy":[[0,5,3,4],[0,3,5,6],[0,6,5,4],[0,4,6,5]],
    "tense":     [[0,1,4,0],[0,5,1,4],[0,3,6,4],[0,6,1,0]],
    "combat":    [[0,3,4,0],[0,5,4,0],[0,3,6,4],[0,4,3,4]],
    "crisis":    [[0,1,2,3],[0,3,1,4],[0,2,4,1],[0,5,2,6]]
  },
  "pulseDecay": {
    "rate": 0.7,
    "threshold": 0.01
  },
  "eventPulseWeights": {
    "combat_attack": 0.3,
    "combat_block": 0.3,
    "actor_killed_self": 0.6,
    "actor_killed_other": 0.2,
    "actor_incapacitated": 0.4,
    "social_interaction": 0.3,
    "mental_break": 1.0,
    "mental_break_end": -0.5,
    "weather_lightning_strike": 0.15
  }
}
